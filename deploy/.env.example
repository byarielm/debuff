# Image built from origin/dev. Pin this until an intentional upgrade.
DEBUFF_IMAGE=ghcr.io/gamesgamesgamesgamesgames/debuff:1.0.0-dev.10

# Persistent directories on the Proxmox LXC host, not paths inside the Docker
# container. Create data/ and config/ beneath this directory before startup.
NEATOPAUSE_STATE_DIR=/opt/neatopause

# Keep Docker private. Tailscale Serve proxies this loopback port over HTTPS.
DEBUFF_PORT=3000

# This must match the externally visible HTTPS URL exactly. Keep the trailing
# slash off: it determines OAuth redirect and client-metadata URLs.
DEBUFF_PUBLIC_URL=https://neatopause.example-tailnet.ts.net

# Generate with: openssl rand -hex 32
# Never commit the generated value.
DEBUFF_SESSION_SECRET=REPLACE_WITH_A_RANDOM_64_HEX_CHARACTER_SECRET

# Persist the config written by the first-run onboarding flow. It records the
# labeler DID and the path to the generated signing key.
DEBUFF_CONFIG=/srv/config/config.toml

# The image already supplies these defaults. They are explicit here so the
# deployment's database and frontend paths remain clear and stable.
DEBUFF_DATABASE_URL=sqlite:///srv/data/debuff.db?mode=rwc
DEBUFF_STATIC_DIR=/srv/static
RUST_LOG=debuff=info,tower_http=info
